SECRET_KEY=change-me-to-a-long-random-value
COOKIE_SECURE=auto

# Optional first-run credentials. If blank, secure random passwords are printed
# once to stdout/journal logs when the first database is created.
INITIAL_ADMIN_PASSWORD=
INITIAL_OWNER_PASSWORD=

# Optional Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ACCOUNTANT_CHAT_ID=

# Set to 1 for local development if you do not want reminder/report jobs running.
TASK_MANAGER_DISABLE_SCHEDULER=1
